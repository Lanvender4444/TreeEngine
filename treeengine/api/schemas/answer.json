  "title": "AnswerV1",
  "description": "AnswerV1(question: 'str', status: 'str', answer: 'str', citations: 'list[CitationV1]' = <factory>, context_spans: 'list[ContextSpanV1]' = <factory>, retry: 'dict[str, Any] | None' = None, schema_version: 'str' = '1')",
