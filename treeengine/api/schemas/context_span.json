{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lanvender4444/TreeEngine/schemas/v1/context_span.json",
  "title": "ContextSpanV1",
  "description": "A continuous reading span: what a model should read, with provenance.",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "token_count": {
      "type": "integer"
    },
    "block_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_start": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "page_end": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "start_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "citation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CitationV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping": {
      "anyOf": [
        {
          "$ref": "#/$defs/MappingV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "text",
    "document_id",
    "token_count"
  ],
  "$defs": {
    "CitationV1": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "document_id"
      ]
    },
    "MappingV1": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "mapped_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "type": "number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "status"
      ]
    }
  }
}
