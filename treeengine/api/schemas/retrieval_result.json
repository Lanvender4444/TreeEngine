{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lanvender4444/TreeEngine/schemas/v1/retrieval_result.json",
  "title": "RetrievalResultV1",
  "description": "RetrievalResultV1(query: 'str', status: 'str', retrieval: 'RetrievalInfoV1', evidence: 'list[EvidenceV1]' = <factory>, context_spans: 'list[ContextSpanV1]' = <factory>, stats: 'RetrievalStatsV1' = <factory>, trace_id: 'str | None' = None, trace: 'list[dict[str, Any]] | None' = None, schema_version: 'str' = '1')",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalInfoV1"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceV1"
      }
    },
    "context_spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextSpanV1"
      }
    },
    "stats": {
      "$ref": "#/$defs/RetrievalStatsV1"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "query",
    "status",
    "retrieval"
  ],
  "$defs": {
    "RetrievalInfoV1": {
      "type": "object",
      "properties": {
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_policy": {
          "type": "string"
        },
        "paths_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "degradations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "EvidenceV1": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "retrieval_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "document_id",
        "text"
      ]
    },
    "ContextSpanV1": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "token_count": {
          "type": "integer"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappingV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "text",
        "document_id",
        "token_count"
      ]
    },
    "CitationV1": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string"
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "document_id"
      ]
    },
    "MappingV1": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "mapped_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "type": "number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "status"
      ]
    },
    "RetrievalStatsV1": {
      "type": "object",
      "properties": {
        "latency_ms": {
          "type": "number"
        },
        "context_tokens": {
          "type": "integer"
        },
        "evidence": {
          "type": "integer"
        },
        "llm_calls": {
          "type": "integer"
        },
        "llm_input_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  }
}
